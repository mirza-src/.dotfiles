{
  "dmsWindowsFloatingSeeded": ["mango"],
  "configVersion": 42,
  "batteryChargeLimit": 80,
  "batteryLowThreshold": 30,
  "batteryNotifyLow": true,
  "batteryCriticalNotificationType": 0,
  "batteryAutoPowerSaver": true,
  "lowerDisplayRefreshRateOnBattery": true,
  "launchPrefix": "app2unit",
  "builtInPluginSettings": {
    "dms_settings_search": {
      "trigger": "?"
    },
    "dms_clipboard_search": {
      "trigger": "cb"
    },
    "dms_qr_generator": {
      "trigger": "qr"
    }
  },
