+// A bar config is one object, so changing any field used to persist all of its
+// fields. Load each bar on top of the default bar and save only what differs.
+function barDefault(density, style) {
+    return densityDefault("barConfigs", density, style)[0];
+}
+
+function withBarDefaults(configs, density, style) {
+    if (!Array.isArray(configs))
+        return configs;
+    var def = barDefault(density, style);
+    return configs.map(function (config) {
+        return Object.assign(Util.cloneDef(def), config);
+    });
+}
+
+function withoutBarDefaults(configs, density, style) {
+    if (!Array.isArray(configs))
+        return configs;
+    var def = barDefault(density, style);
+    return configs.map(function (config) {
+        var out = {};
+        for (var field in config) {
+            if (field !== "id" && field in def && Util.isDefault(config[field], def[field]))
+                continue;
+            out[field] = config[field];
+        }
+        return out;
+    });
+}
