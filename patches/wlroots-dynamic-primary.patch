+// Copy a client buffer the main renderer can't import into a linear buffer
+// using the import helper, and import that instead.
+static struct wlr_client_buffer *import_via_helper(struct wlr_surface *surface,
+		struct wlr_buffer *buffer) {
+	struct wlr_compositor *compositor = surface->compositor;
+	struct wlr_renderer *helper = compositor->import_renderer;
+	struct wlr_allocator *allocator = compositor->import_allocator;
+	if (helper == NULL || allocator == NULL || !helper->features.timeline) {
+		return NULL;
+	}
+
+	struct wlr_dmabuf_attributes dmabuf;
+	if (!wlr_buffer_get_dmabuf(buffer, &dmabuf)) {
+		return NULL;
+	}
+
+	const struct wlr_drm_format_set *main_formats = wlr_renderer_get_texture_formats(
+		compositor->renderer, WLR_BUFFER_CAP_DMABUF);
+	if (main_formats == NULL || !wlr_drm_format_set_has(main_formats,
+			dmabuf.format, DRM_FORMAT_MOD_LINEAR)) {
+		return NULL;
+	}
+
+	struct import_copy *copy = NULL;
+	struct wlr_addon *addon = wlr_addon_find(&surface->addons, compositor,
+		&import_copy_impl);
+	if (addon != NULL) {
+		copy = wl_container_of(addon, copy, addon);
+	} else {
+		copy = calloc(1, sizeof(*copy));
+		if (copy == NULL) {
+			return NULL;
+		}
+		wlr_addon_init(&copy->addon, &surface->addons, compositor,
+			&import_copy_impl);
+		log_import_copy_client(surface, true);
+	}
+
+	if (copy->swapchain == NULL || copy->swapchain->allocator != allocator ||
+			copy->swapchain->width != buffer->width ||
+			copy->swapchain->height != buffer->height ||
+			copy->format != dmabuf.format) {
+		wlr_swapchain_destroy(copy->swapchain);
+		struct wlr_drm_format format = {0};
+		format.format = dmabuf.format;
+		if (!wlr_drm_format_add(&format, DRM_FORMAT_MOD_LINEAR)) {
+			copy->swapchain = NULL;
+			return NULL;
+		}
+		copy->swapchain = wlr_swapchain_create(allocator, buffer->width,
+			buffer->height, &format);
+		wlr_drm_format_finish(&format);
+		copy->format = dmabuf.format;
+		if (copy->swapchain == NULL) {
+			return NULL;
+		}
+	}
+
+	if (copy->timeline != NULL &&
+			copy->timeline->drm_fd != wlr_renderer_get_drm_fd(helper)) {
+		wlr_drm_syncobj_timeline_unref(copy->timeline);
+		copy->timeline = NULL;
+	}
+	if (copy->timeline == NULL) {
+		copy->timeline = wlr_drm_syncobj_timeline_create(
+			wlr_renderer_get_drm_fd(helper));
+		copy->point = 0;
+		if (copy->timeline == NULL) {
+			return NULL;
+		}
+	}
+
+	struct wlr_texture *src = wlr_texture_from_buffer(helper, buffer);
+	if (src == NULL) {
+		return NULL;
+	}
+	struct wlr_buffer *dst = wlr_swapchain_acquire(copy->swapchain);
+	if (dst == NULL) {
+		wlr_texture_destroy(src);
+		return NULL;
+	}
+
+	struct wlr_render_texture_options tex_options = {
+		.texture = src,
+		.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+	};
+	struct wlr_linux_drm_syncobj_surface_v1_state *syncobj_state =
+		wlr_linux_drm_syncobj_v1_get_surface_state(surface);
+	if (syncobj_state != NULL && syncobj_state->acquire_timeline != NULL) {
+		tex_options.wait_timeline = syncobj_state->acquire_timeline;
+		tex_options.wait_point = syncobj_state->acquire_point;
+	}
+
+	struct wlr_client_buffer *client_buffer = NULL;
+	struct wlr_render_pass *pass = wlr_renderer_begin_buffer_pass(helper, dst,
+		&(struct wlr_buffer_pass_options){
+			.signal_timeline = copy->timeline,
+			.signal_point = copy->point + 1,
+		});
+	if (pass != NULL) {
+		wlr_render_pass_add_texture(pass, &tex_options);
+		if (wlr_render_pass_submit(pass)) {
+			copy->point++;
+			// The texture locks dst, so the swapchain won't reuse it while
+			// it's in use
+			client_buffer = wlr_client_buffer_create(dst, compositor->renderer);
+		}
+		if (client_buffer != NULL) {
+			// Implicit sync from one GPU to another isn't reliable everywhere:
+			// let whoever samples the texture wait for the copy explicitly
+			client_buffer->wait_timeline = wlr_drm_syncobj_timeline_ref(copy->timeline);
+			client_buffer->wait_point = copy->point;
+		}
+	}
+	wlr_texture_destroy(src);
+	wlr_buffer_unlock(dst);
+	return client_buffer;
+}
