+	wl_list_for_each(conn, &drm->connectors, link) {
+		if (conn->status != DRM_MODE_CONNECTED || conn->lease != NULL ||
+				conn->output.non_desktop) {
+			continue;
+		}
+		if (internal_only && !connector_is_internal(conn)) {
+			continue;
+		}
+		return true;
+	}
+	return false;
+}
