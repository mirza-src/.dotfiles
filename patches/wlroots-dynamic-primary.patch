+	pid_t pid = 0;
+	wl_client_get_credentials(wl_resource_get_client(surface->resource),
+		&pid, NULL, NULL);
+
+	char comm[64] = "?";
+	char path[64];
+	snprintf(path, sizeof(path), "/proc/%d/comm", (int)pid);
+	FILE *f = fopen(path, "r");
+	if (f != NULL) {
+		if (fgets(comm, sizeof(comm), f) != NULL) {
+			comm[strcspn(comm, "\n")] = '\0';
+		}
+		fclose(f);
+	}
+	if (needed) {
+		wlr_log(WLR_INFO, "Surface of %s (pid %d) renders on another GPU, "
+			"showing it through the import helper", comm, (int)pid);
+	} else {
+		wlr_log(WLR_INFO, "Surface of %s (pid %d) no longer needs the "
+			"import helper", comm, (int)pid);
