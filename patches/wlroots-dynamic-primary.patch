+/**
+ * Pick the GPU which should be primary among the group of drm, ignoring
+ * exclude (may be NULL). A GPU driving a connected internal panel wins,
+ * otherwise the first GPU (in creation order, ie. WLR_DRM_DEVICES order)
+ * with any connected output. Returns NULL if no GPU qualifies.
+ */
+static struct wlr_drm_backend *pick_primary(struct wlr_drm_backend *drm,
+		struct wlr_drm_backend *exclude, const char **reason) {
+	struct wlr_drm_backend *internal = NULL, *any = NULL;
+	struct wlr_drm_backend *cur = drm;
+	do {
+		if (cur != exclude) {
+			if (drm_backend_has_connected(cur, true) &&
+					(internal == NULL || cur->seq < internal->seq)) {
+				internal = cur;
+			}
+			if (drm_backend_has_connected(cur, false) &&
+					(any == NULL || cur->seq < any->seq)) {
+				any = cur;
+			}
+		}
+		cur = wl_container_of(cur->group_link.next, cur, group_link);
+	} while (cur != drm);
+
+	if (internal != NULL) {
+		*reason = "it drives the internal panel";
+		return internal;
+	}
+	*reason = "first GPU with a connected output";
+	return any;
+}
+
+/**
+ * Turn new_primary (currently a secondary) into the primary of its group, and
+ * all other members except dying into its secondaries. The previous primary
+ * must already have its mgpu renderer set up, unless it is dying.
+ */
+static void drm_backend_promote(struct wlr_drm_backend *new_primary,
+		struct wlr_drm_backend *dying) {
+	assert(new_primary->parent != NULL);
+
+	// The new primary renders itself, drop all of its blit state
+	for (size_t i = 0; i < new_primary->num_planes; i++) {
+		finish_drm_surface(&new_primary->planes[i].mgpu_surf);
+	}
+	restore_plane_formats(new_primary);
+	new_primary->mgpu_retry = false;
+	finish_mgpu_renderer(new_primary);
+	new_primary->backend.features.timeline = new_primary->kms_timeline;
+
+	struct wlr_drm_backend *cur = new_primary;
+	while ((cur = wl_container_of(cur->group_link.next, cur, group_link)) != new_primary) {
+		wl_list_remove(&cur->parent_destroy.link);
+		cur->parent = new_primary;
+		if (cur == dying) {
+			// Not a member anymore, but keep a pointer to the successor
+			// for drm_backend_monitor
+			wl_list_init(&cur->parent_destroy.link);
+			continue;
+		}
+		cur->parent_destroy.notify = handle_parent_destroy;
+		wl_signal_add(&new_primary->backend.events.destroy, &cur->parent_destroy);
+	}
+
+	wl_list_remove(&new_primary->parent_destroy.link);
+	wl_list_init(&new_primary->parent_destroy.link);
+	new_primary->parent = NULL;
+
+	// Let the multi backend recompute the intersection of features
+	cur = new_primary;
+	do {
+		multi_backend_refresh_features_for_sub(&cur->backend);
+		cur = wl_container_of(cur->group_link.next, cur, group_link);
+	} while (cur != new_primary);
+}
+
+static bool same_device(int fd_a, int fd_b) {
+	drmDevice *dev_a = NULL, *dev_b = NULL;
+	bool same = false;
+	if (drmGetDevice2(fd_a, 0, &dev_a) == 0 &&
+			drmGetDevice2(fd_b, 0, &dev_b) == 0) {
+		same = drmDevicesEqual(dev_a, dev_b);
+	}
+	drmFreeDevice(&dev_a);
+	drmFreeDevice(&dev_b);
+	return same;
+}
+
+/**
+ * Emit the lost signal once on each renderer used by outputs of the group,
+ * unless it already renders on the new primary. Compositors handle this like
+ * a GPU reset and re-create their renderer and allocator, which picks up the
+ * new primary via wlr_backend_get_drm_fd().
+ */
+static void drm_backend_emit_renderer_lost(struct wlr_drm_backend *primary) {
+	struct wl_array renderers;
+	wl_array_init(&renderers);
+
+	struct wlr_drm_backend *cur = primary;
+	do {
+		struct wlr_drm_connector *conn;
+		wl_list_for_each(conn, &cur->connectors, link) {
+			struct wlr_renderer *renderer = conn->output.renderer;
+			if (conn->status != DRM_MODE_CONNECTED || renderer == NULL) {
+				continue;
+			}
+
+			bool found = false;
+			struct wlr_renderer **r;
+			wl_array_for_each(r, &renderers) {
+				found = found || *r == renderer;
+			}
+			if (found) {
+				continue;
+			}
+
+			int render_fd = wlr_renderer_get_drm_fd(renderer);
+			if (render_fd >= 0 && same_device(render_fd, primary->fd)) {
+				continue;
+			}
+
+			r = wl_array_add(&renderers, sizeof(*r));
+			if (r == NULL) {
+				wlr_log(WLR_ERROR, "Allocation failed");
+				continue;
+			}
+			*r = renderer;
+		}
+		cur = wl_container_of(cur->group_link.next, cur, group_link);
+	} while (cur != primary);
+
+	// Collected first because the compositor will likely destroy renderers
+	// and re-initialize outputs from within the signal handler
+	struct wlr_renderer **r;
+	wl_array_for_each(r, &renderers) {
+		wlr_log(WLR_INFO, "Signalling renderer loss to switch to primary GPU %s",
+			primary->name);
+		wl_signal_emit_mutable(&(*r)->events.lost, NULL);
+	}
+	wl_array_release(&renderers);
+}
+
+static bool drm_backend_has_enabled_outputs(struct wlr_drm_backend *drm) {
+	struct wlr_drm_connector *conn;
+	wl_list_for_each(conn, &drm->connectors, link) {
+		if (conn->status == DRM_MODE_CONNECTED && conn->output.enabled) {
+			return true;
+		}
+	}
+	return false;
+}
+
+void drm_backend_retry_mgpu_renderer(struct wlr_drm_backend *drm) {
+	if (!drm->mgpu_retry || drm->parent == NULL) {
+		return;
+	}
+	if (drm->mgpu_renderer.wlr_rend != NULL) {
+		drm->mgpu_retry = false;
+		return;
+	}
+	if (!init_mgpu_renderer(drm, false)) {
+		wlr_log(WLR_DEBUG, "Multi-GPU renderer on %s still unavailable",
+			drm->name);
+		return;
+	}
+	// Real blit renderer now: planes no longer need the sanitized formats
+	restore_plane_formats(drm);
+	drm->mgpu_retry = false;
+	multi_backend_refresh_features_for_sub(&drm->backend);
+	wlr_log(WLR_INFO, "Multi-GPU renderer on %s set up", drm->name);
+}
+
+bool wlr_drm_backend_set_primary(struct wlr_backend *backend) {
+	struct wlr_drm_backend *drm = get_drm_backend_from_backend(backend);
+	struct wlr_drm_backend *old_primary = drm->parent;
+	if (old_primary == NULL) {
+		return true;
+	}
+
+	uint64_t cap;
+	if (drmGetCap(drm->fd, DRM_CAP_PRIME, &cap) ||
+			!(cap & DRM_PRIME_CAP_EXPORT)) {
+		wlr_log(WLR_ERROR, "Cannot make %s primary: PRIME export not supported",
+			drm->name);
+		return false;
+	}
+
+	// The old primary needs a blit renderer to become a secondary. This is
+	// the only step which can fail, do it before touching anything else.
+	if (!init_mgpu_renderer(old_primary, false)) {
+		// Moving rendering *off* a GPU must not depend on being able to use
+		// it: it may already be powered down or blocked. That's fine as long
+		// as none of its outputs are lit; set up the blit renderer later.
+		if (drm_backend_has_enabled_outputs(old_primary)) {
+			wlr_log(WLR_ERROR, "Cannot make %s primary: failed to set up "
+				"multi-GPU renderer on %s, which still drives outputs",
+				drm->name, old_primary->name);
+			return false;
+		}
+		wlr_log(WLR_INFO, "No multi-GPU renderer on %s (no lit outputs), "
+			"will retry on its next connector scan", old_primary->name);
+		sanitize_plane_formats(old_primary);
+		old_primary->mgpu_retry = true;
+	}
+
+	drm_backend_promote(drm, NULL);
+	wlr_log(WLR_INFO, "Primary GPU changed from %s to %s",
+		old_primary->name, drm->name);
+
+	drm_backend_emit_renderer_lost(drm);
+	return true;
+}
+
+static void handle_primary_update_idle(void *data) {
+	struct wlr_drm_backend *drm = data;
+	drm->primary_update_idle = NULL;
+
+	struct wlr_drm_backend *current = drm->parent ? drm->parent : drm;
+	if (wl_list_empty(&current->group_link)) {
+		return; // Single GPU
+	}
+
+	const char *reason = NULL;
+	struct wlr_drm_backend *best = pick_primary(current, NULL, &reason);
+	if (best == NULL) {
+		wlr_log(WLR_DEBUG, "No GPU has a connected output, "
+			"keeping %s as primary GPU", current->name);
+		return;
+	}
+	if (best == current) {
+		return;
+	}
+
+	wlr_log(WLR_INFO, "Switching primary GPU from %s to %s: %s",
+		current->name, best->name, reason);
+	if (!wlr_drm_backend_set_primary(&best->backend)) {
+		wlr_log(WLR_ERROR, "Failed to switch primary GPU to %s, keeping %s",
+			best->name, current->name);
+	}
+}
+
+void drm_backend_schedule_primary_update(struct wlr_drm_backend *drm) {
+	if (drm->primary_update_idle != NULL || !dynamic_primary_enabled()) {
+		return;
+	}
+	// Deferred so that hotplug events of all GPUs (eg. a panel moving from one
+	// GPU to another via a mux) are processed before deciding
+	drm->primary_update_idle = wl_event_loop_add_idle(drm->session->event_loop,
+		handle_primary_update_idle, drm);
+	if (drm->primary_update_idle == NULL) {
+		wlr_log(WLR_ERROR, "Failed to schedule primary GPU update");
+	}
+}
