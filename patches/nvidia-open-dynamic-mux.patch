+static NVDpyEvoPtr FindInternalMuxDpy(void)
+{
+    NVDevEvoPtr pDevEvo;
+
+    FOR_ALL_EVO_DEVS(pDevEvo) {
+        NVDispEvoPtr pDispEvo;
+        int i;
+
+        FOR_ALL_EVO_DISPLAYS(pDispEvo, i, pDevEvo) {
+            NVDpyEvoPtr pDpyEvo;
+
+            FOR_ALL_EVO_DPYS(pDpyEvo, pDispEvo->muxDisplays, pDispEvo) {
+                if (pDpyEvo->internal) {
+                    return pDpyEvo;
+                }
+            }
+        }
+    }
+
+    return NULL;
+}
+
+/*
+ * Kernel-side equivalent of NVKMS_IOCTL_SWITCH_MUX PRE/SWITCH/POST for the
+ * internal panel. nvidia-drm holds modeset ownership, so a userspace NVKMS
+ * client cannot issue the ioctl itself. Called with the pm read lock and
+ * nvkms_lock held.
+ */
+NvBool nvKmsSwitchInternalMux(NvU32 state)
+{
+    const NvMuxState muxState = (NvMuxState)state;
+    NVDpyEvoPtr pDpyEvo = FindInternalMuxDpy();
+    NvBool ok;
+
+    if (pDpyEvo == NULL) {
+        nvEvoLog(EVO_LOG_WARN, "mux: no internal display behind a dynamic mux");
+        return FALSE;
+    }
+
+    if (nvRmMuxState(pDpyEvo) == muxState) {
+        return TRUE;
+    }
+
+    if (!nvRmMuxPre(pDpyEvo, muxState)) {
+        if (!nvkms_mux_force()) {
+            nvEvoLogDisp(pDpyEvo->pDispEvo, EVO_LOG_WARN,
+                         "mux: pre-switch failed (set mux_force=1 to continue anyway)");
+            return FALSE;
+        }
+        nvEvoLogDisp(pDpyEvo->pDispEvo, EVO_LOG_WARN,
+                     "mux: pre-switch failed, continuing (mux_force)");
+    }
+
+    ok = nvRmMuxSwitch(pDpyEvo, muxState);
+    if (!ok) {
+        nvEvoLogDisp(pDpyEvo->pDispEvo, EVO_LOG_WARN, "mux: switch failed");
+    }
+
+    /* Run post even after a failed switch: it restores the panel power and
+     * backlight control that pre took over. */
+    if (!nvRmMuxPost(pDpyEvo, muxState)) {
+        nvEvoLogDisp(pDpyEvo->pDispEvo, EVO_LOG_WARN, "mux: post-switch failed");
+        ok = FALSE;
+    }
+
+    /* The panel left this GPU: tell DPLib so the connector reads disconnected. */
+    if (ok && muxState == MUX_STATE_INTEGRATED &&
+        nvConnectorUsesDPLib(pDpyEvo->pConnectorEvo)) {
+        nvDPNotifyLongPulse(pDpyEvo->pConnectorEvo, FALSE);
+        nvDPFireExpiredTimers(pDpyEvo->pDispEvo->pDevEvo);
+    }
+
+    nvEvoLogDisp(pDpyEvo->pDispEvo, EVO_LOG_INFO, "mux: %s -> %s %s",
+                 pDpyEvo->name,
+                 muxState == MUX_STATE_DISCRETE ? "dGPU" : "iGPU",
+                 ok ? "ok" : "FAILED");
+    return ok;
+}
+
+NvU32 nvKmsGetInternalMuxState(void)
+{
+    NVDpyEvoPtr pDpyEvo = FindInternalMuxDpy();
+
+    return pDpyEvo ? (NvU32)nvRmMuxState(pDpyEvo) : (NvU32)MUX_STATE_UNKNOWN;
+}
