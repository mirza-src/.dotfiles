+#if NV_FILESYSTEM_ACCESS_AVAILABLE
+/*
+ * Open @path relative to PID 1's root (the real system root) instead of the
+ * caller's. Uses file_open_root(const struct path *, ...), Linux >= 5.12.
+ */
+static struct file *nv_filp_open_init_root(const char *path)
+{
+    struct pid *pid = find_get_pid(1);
+    struct task_struct *task = NULL;
+    struct file *file = ERR_PTR(-ESRCH);
+    struct path root;
+
+    if (pid != NULL)
+    {
+        task = get_pid_task(pid, PIDTYPE_PID);
+        put_pid(pid);
+    }
+    if (task == NULL)
+        return file;
+
+    task_lock(task);
+    if (task->fs != NULL)
+    {
+        get_fs_root(task->fs, &root);
+        task_unlock(task);
+        file = file_open_root(&root, path, O_RDONLY, 0);
+        path_put(&root);
+    }
+    else
+    {
+        task_unlock(task);
+    }
+    put_task_struct(task);
+    return file;
+}
+#endif
