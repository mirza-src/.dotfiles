--- /dev/null
+++ b/crates/cardwire-daemon/src/interface/mux.rs
@@ -0,0 +1,78 @@
+//! Define the live display mux dbus (Ultimate mode)
+use crate::{core::errors::CardwireError, interface::ModeInterface};
+use log::warn;
+use zbus::{fdo, interface};
+
+#[derive(Clone)]
+pub struct MuxInterface {
+    mode: ModeInterface,
+}
+
+impl MuxInterface {
+    pub fn build(mode: ModeInterface) -> Self {
+        Self { mode }
+    }
+}
+
+fn into_fdo(err: CardwireError) -> fdo::Error {
+    match err {
+        CardwireError::FdoError(err) => err,
+        err => fdo::Error::Failed(err.to_string()),
+    }
+}
+
+/// Emit PropertiesChanged for every Mux property, no-op until the interface is served
+pub(crate) async fn emit_mux_changed(mode: &ModeInterface) {
+    let Some(emitter) = mode.mux.signal_emitter.get() else {
+        return;
+    };
+    let iface = MuxInterface { mode: mode.clone() };
+    let results = [
+        iface.state_changed(emitter).await,
+        iface.panel_gpu_changed(emitter).await,
+        iface.last_error_changed(emitter).await,
+        iface.capable_changed(emitter).await,
+    ];
+    for err in results.into_iter().filter_map(|res| res.err()) {
+        warn!("failed to emit Mux property change: {err}");
+    }
+}
+
+#[interface(name = "org.opengamingcollective.cardwire.Mux")]
+impl MuxInterface {
+    /// Whether a live display mux is available (Ultimate mode can be selected)
+    #[zbus(property)]
+    pub async fn capable(&self) -> fdo::Result<bool> {
+        Ok(self.mode.mux_capable().await)
+    }
+
+    /// GPU driving the internal panel: igpu, dgpu or unknown
+    #[zbus(property)]
+    pub async fn panel_gpu(&self) -> fdo::Result<String> {
+        Ok(self.mode.mux.panel_gpu().await.as_str().to_string())
+    }
+
+    /// idle, switching, pending (Ultimate waiting for ApplyPending) or degraded (the panel could
+    /// not be moved back to the iGPU, or the driver path is wedged)
+    #[zbus(property)]
+    pub async fn state(&self) -> fdo::Result<String> {
+        Ok(self.mode.mux.state().as_str().to_string())
+    }
+
+    /// Last mux error, empty when the last switch succeeded
+    #[zbus(property)]
+    pub async fn last_error(&self) -> fdo::Result<String> {
+        Ok(self.mode.mux.last_error())
+    }
+
+    /// Apply a persisted Ultimate mode that was deferred at boot or after resume.
+    /// Meant to be called once the graphical session is up. No-op when nothing is pending.
+    pub async fn apply_pending(&self) -> fdo::Result<()> {
+        self.mode.apply_pending().await.map_err(into_fdo)
+    }
+
+    /// Re-read the mux state and reconcile it with the current mode (used after resume)
+    pub async fn reconcile(&self) -> fdo::Result<()> {
+        self.mode.reconcile_mux().await.map_err(into_fdo)
+    }
+}
