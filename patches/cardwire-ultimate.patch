diff --git a/crates/cardwire-daemon/src/tasks/logind.rs b/crates/cardwire-daemon/src/tasks/logind.rs
new file mode 100644
index 0000000..c182dbd
--- /dev/null
+++ b/crates/cardwire-daemon/src/tasks/logind.rs
@@ -0,0 +1,90 @@
+//! Listen to logind to hand the internal panel back to the iGPU before shutdown and to
+//! reconcile the live display mux after resume
+
+use std::time::Duration;
+
+use log::{info, warn};
+use tokio_stream::StreamExt;
+use zbus::{Connection, Result, proxy, zvariant::OwnedFd};
+
+use crate::interface::ModeInterface;
+
+/// Let the hardware and the compositor settle after resume before re-reading the mux
+const RESUME_SETTLE: Duration = Duration::from_secs(2);
+
+#[proxy(
+    interface = "org.freedesktop.login1.Manager",
+    default_service = "org.freedesktop.login1",
+    default_path = "/org/freedesktop/login1"
+)]
+trait Login1Manager {
+    fn inhibit(&self, what: &str, who: &str, why: &str, mode: &str) -> Result<OwnedFd>;
+
+    #[zbus(signal)]
+    fn prepare_for_shutdown(&self, start: bool) -> Result<()>;
+
+    #[zbus(signal)]
+    fn prepare_for_sleep(&self, start: bool) -> Result<()>;
+}
+
+/// Take a shutdown delay inhibitor so logind waits for the panel handover
+async fn shutdown_inhibitor(proxy: &Login1ManagerProxy<'_>) -> Option<OwnedFd> {
+    match proxy
+        .inhibit(
+            "shutdown",
+            "cardwire",
+            "Move the internal panel back to the iGPU",
+            "delay",
+        )
+        .await
+    {
+        Ok(fd) => Some(fd),
+        Err(err) => {
+            warn!("failed to take a logind shutdown inhibitor: {err}");
+            None
+        }
+    }
+}
+
+pub async fn watch_logind(mode_interface: ModeInterface) -> zbus::Result<()> {
+    let connection = Connection::system().await?;
+    let proxy = Login1ManagerProxy::new(&connection).await?;
+    let mut shutdown_stream = proxy.receive_prepare_for_shutdown().await?;
+    let mut sleep_stream = proxy.receive_prepare_for_sleep().await?;
+    let mut inhibitor = shutdown_inhibitor(&proxy).await;
+
+    loop {
+        tokio::select! {
+            Some(signal) = shutdown_stream.next() => {
+                let Ok(args) = signal.args() else { continue };
+                if args.start {
+                    info!("shutdown requested, moving the internal panel back to the iGPU");
+                    mode_interface.leave_for_shutdown().await;
+                    // Release the delay lock so the shutdown proceeds
+                    drop(inhibitor.take());
+                } else {
+                    // Shutdown was cancelled: the panel may already be back on the iGPU while the
+                    // mode still says Ultimate, reconcile (marks Ultimate pending)
+                    if let Err(err) = mode_interface.reconcile_mux().await {
+                        warn!("failed to reconcile the mux after a cancelled shutdown: {err}");
+                    }
+                    if inhibitor.is_none() {
+                        inhibitor = shutdown_inhibitor(&proxy).await;
+                    }
+                }
+            }
+            Some(signal) = sleep_stream.next() => {
+                let Ok(args) = signal.args() else { continue };
+                if !args.start {
+                    info!("resumed from sleep, reconciling the live display mux");
+                    tokio::time::sleep(RESUME_SETTLE).await;
+                    if let Err(err) = mode_interface.reconcile_mux().await {
+                        warn!("failed to reconcile the mux after resume: {err}");
+                    }
+                }
+            }
+            else => break,
+        }
+    }
+    Ok(())
+}
