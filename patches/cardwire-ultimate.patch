diff --git a/crates/cardwire-daemon/src/core/mux.rs b/crates/cardwire-daemon/src/core/mux.rs
new file mode 100644
index 0000000..b22922c
--- /dev/null
+++ b/crates/cardwire-daemon/src/core/mux.rs
@@ -0,0 +1,849 @@
+//! Live display mux driver used by the Ultimate mode.
+//!
+//! Some laptops (e.g. the ASUS ROG Zephyrus G14 2025) route the internal panel through a mux that
+//! can be flipped at runtime between the iGPU and the dGPU. A patched `nvidia-modeset` exposes the
+//! mux as module parameters:
+//!
+//! - `/sys/module/nvidia_modeset/parameters/mux`: write `igpu` | `dgpu`, reads back `igpu` | `dgpu`
+//!   | `unknown`. A failed write returns EIO, a wedged driver can block the writer forever
+//!   (uninterruptible sleep).
+//! - `/sys/module/nvidia_modeset/parameters/mux_igpu_brightness`: brightness (0-100) handed over to
+//!   the dGPU panel when switching.
+//!
+//! [`MuxController`] ports the proven shell sequence: it drives the mux, forces connector
+//! detection, sends synthetic DRM hotplug uevents so the compositor picks up the panel on the new
+//! GPU, and reverts to the iGPU on any failure.
+//!
+//! Every sysfs access that reaches a driver runs on a dedicated, detached `std::thread` with a
+//! timeout (see [`sysfs_io`]): a thread stuck in D-state must neither stall the tokio runtime nor
+//! its shutdown, so `spawn_blocking` is deliberately not used for those (only for procfs reads,
+//! which can't hang in a driver).
+
+use log::{error, info, warn};
+use std::{
+    fs, io, path::{Path, PathBuf}, sync::{
+        Mutex, OnceLock, atomic::{AtomicBool, Ordering}
+    }, time::{Duration, Instant}
+};
+use thiserror::Error;
+use zbus::object_server::SignalEmitter;
+
+/// nvidia-modeset mux parameter.
+const MUX_PARAM: &str = "/sys/module/nvidia_modeset/parameters/mux";
+/// nvidia-modeset brightness handover parameter (0-100).
+const MUX_BRIGHTNESS_PARAM: &str = "/sys/module/nvidia_modeset/parameters/mux_igpu_brightness";
+/// acpi_call interface used as a last resort when the driver path is wedged.
+const ACPI_CALL: &str = "/proc/acpi/call";
+/// ACPI method switching the panel mux back to the iGPU (ASUS G14 2025).
+const ACPI_MXDS_IGPU: &str = "\\_SB.PCI0.GPP9.PEGP.LCD0.MXDS 0x1";
+
+/// Timeout of a mux parameter write before the driver path is considered wedged.
+const MUX_WRITE_TIMEOUT: Duration = Duration::from_secs(5);
+/// Timeout of a single "ordinary" sysfs access (connector status, uevent, power control...).
+const SYSFS_TIMEOUT: Duration = Duration::from_secs(3);
+/// How long to wait for the target eDP connector to report `connected`.
+const DETECT_TIMEOUT: Duration = Duration::from_secs(8);
+/// How long to wait for the compositor to light the dGPU eDP connector.
+const ENABLE_TIMEOUT: Duration = Duration::from_secs(5);
+/// Overall deadline of an enter sequence, measured from the mux write: past it, revert.
+const ENTER_DEADLINE: Duration = Duration::from_secs(20);
+/// Delay between polls of a connector.
+const POLL_INTERVAL: Duration = Duration::from_millis(250);
+/// Settle time between lighting the iGPU panel and turning the dGPU connector off.
+const LEAVE_SETTLE: Duration = Duration::from_secs(1);
+/// After the panel is lit on the iGPU, time for the compositor to move its renderer off the
+/// dGPU (renderer re-creation is deferred) before a mode that blocks the dGPU is applied.
+pub const RENDER_SETTLE: Duration = Duration::from_secs(2);
+
+/// GPU currently driving the internal panel, as reported by the mux parameter.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PanelGpu {
+    Igpu,
+    Dgpu,
+    Unknown,
+}
+
+impl PanelGpu {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            PanelGpu::Igpu => "igpu",
+            PanelGpu::Dgpu => "dgpu",
+            PanelGpu::Unknown => "unknown",
+        }
+    }
+
+    fn parse(value: &str) -> Self {
+        match value.trim() {
+            "igpu" => PanelGpu::Igpu,
+            "dgpu" => PanelGpu::Dgpu,
+            _ => PanelGpu::Unknown,
+        }
+    }
+}
+
+/// State of the mux controller exposed on D-Bus.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MuxState {
+    /// Nothing in flight.
+    Idle,
+    /// A switch sequence is running.
+    Switching,
+    /// Ultimate is the persisted mode but was not applied yet (early boot / after resume),
+    /// waiting for `ApplyPending`.
+    Pending,
+    /// The panel could not be moved back to the iGPU, or the driver path is wedged.
+    Degraded,
+}
+
+impl MuxState {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            MuxState::Idle => "idle",
+            MuxState::Switching => "switching",
+            MuxState::Pending => "pending",
+            MuxState::Degraded => "degraded",
+        }
+    }
+}
+
+#[derive(Debug, Error)]
+pub enum MuxError {
+    #[error("live display mux not available: {0}")]
+    NotCapable(String),
+
+    #[error(
+        "the nvidia-modeset mux driver path is wedged, switching to the dGPU is disabled until reboot"
+    )]
+    Wedged,
+
+    #[error("{path}: {source}")]
+    Io { path: String, source: io::Error },
+
+    #[error("timed out after {}ms: {what}", .timeout.as_millis())]
+    Timeout { what: String, timeout: Duration },
+
+    #[error("{0}")]
+    Step(String),
+
+    #[error("switch to the dGPU failed ({cause}), the panel was reverted to the iGPU")]
+    Reverted { cause: Box<MuxError> },
+
+    #[error("switch to the dGPU failed ({cause}) and reverting to the iGPU failed too ({revert})")]
+    RevertFailed {
+        cause: Box<MuxError>,
+        revert: Box<MuxError>,
+    },
+}
+
+/// A GPU the mux topology can be resolved from.
+#[derive(Clone, Debug)]
+pub struct MuxGpu {
+    pub pci: String,
+    pub nvidia: bool,
+}
+
+/// Resolved sysfs paths for both sides of the mux.
+///
+/// Card numbers can change between boots, everything is resolved from the PCI addresses.
+#[derive(Clone, Debug)]
+pub struct MuxTopology {
+    pub igpu_pci: String,
+    pub dgpu_pci: String,
+    /// e.g. `card1`
+    pub igpu_card: String,
+    pub dgpu_card: String,
+    /// e.g. `/sys/class/drm/card1-eDP-1`
+    pub igpu_edp: PathBuf,
+    pub dgpu_edp: PathBuf,
+}
+
+#[derive(Default)]
+struct MuxRuntime {
+    switching: bool,
+    pending: bool,
+    degraded: bool,
+    last_error: String,
+}
+
+/// Drives the live display mux. Not reentrant: callers serialize through the mode transition
+/// lock.
+pub struct MuxController {
+    runtime: Mutex<MuxRuntime>,
+    /// Set once a mux write timed out or failed: the driver path is not trusted anymore.
+    wedged: AtomicBool,
+    /// Signal emitter of the Mux D-Bus interface, populated once the interface is served.
+    pub signal_emitter: OnceLock<SignalEmitter<'static>>,
+}
+
+impl Default for MuxController {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl MuxController {
+    pub fn new() -> Self {
+        Self {
+            runtime: Mutex::new(MuxRuntime::default()),
+            wedged: AtomicBool::new(false),
+            signal_emitter: OnceLock::new(),
+        }
+    }
+
+    fn runtime(&self) -> std::sync::MutexGuard<'_, MuxRuntime> {
+        // A poisoned lock only means a panic while holding plain flags: keep going
+        self.runtime.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    /// Current state as exposed on D-Bus.
+    pub fn state(&self) -> MuxState {
+        let runtime = self.runtime();
+        if runtime.switching {
+            MuxState::Switching
+        } else if runtime.degraded || self.is_wedged() {
+            MuxState::Degraded
+        } else if runtime.pending {
+            MuxState::Pending
+        } else {
+            MuxState::Idle
+        }
+    }
+
+    pub fn last_error(&self) -> String {
+        self.runtime().last_error.clone()
+    }
+
+    pub fn set_last_error(&self, err: impl Into<String>) {
+        self.runtime().last_error = err.into();
+    }
+
+    pub fn is_pending(&self) -> bool {
+        self.runtime().pending
+    }
+
+    pub fn set_pending(&self, pending: bool) {
+        self.runtime().pending = pending;
+    }
+
+    pub fn set_switching(&self, switching: bool) {
+        self.runtime().switching = switching;
+    }
+
+    pub fn is_degraded(&self) -> bool {
+        self.runtime().degraded || self.is_wedged()
+    }
+
+    /// Mark the panel as possibly stranded on the dGPU.
+    pub fn set_degraded(&self, err: impl Into<String>) {
+        let mut runtime = self.runtime();
+        runtime.degraded = true;
+        runtime.last_error = err.into();
+    }
+
+    /// Clear the degraded flag once the panel is known to be back on the iGPU. The wedged flag is
+    /// sticky until reboot.
+    pub fn clear_degraded(&self) {
+        self.runtime().degraded = false;
+    }
+
+    pub fn is_wedged(&self) -> bool {
+        self.wedged.load(Ordering::Relaxed)
+    }
+
+    /// Whether the patched nvidia-modeset exposes the mux parameter.
+    pub fn param_present(&self) -> bool {
+        Path::new(MUX_PARAM).exists()
+    }
+
+    /// Read which GPU drives the panel. `Unknown` when the parameter is missing, unreadable or
+    /// does not answer in time.
+    pub async fn panel_gpu(&self) -> PanelGpu {
+        if !self.param_present() {
+            return PanelGpu::Unknown;
+        }
+        match sysfs_io(format!("read {MUX_PARAM}"), SYSFS_TIMEOUT, || {
+            fs::read_to_string(MUX_PARAM)
+        })
+        .await
+        {
+            Ok(value) => PanelGpu::parse(&value),
+            Err(err) => {
+                warn!("mux: could not read the mux state: {err}");
+                PanelGpu::Unknown
+            }
+        }
+    }
+
+    /// Whether Ultimate can be offered on this system.
+    ///
+    /// Requires the mux parameter to read `igpu` or `dgpu`, an available NVIDIA GPU owning an eDP
+    /// connector and an iGPU owning an eDP connector.
+    pub async fn probe(&self, gpus: &[MuxGpu]) -> bool {
+        if !self.param_present() {
+            return false;
+        }
+        if self.panel_gpu().await == PanelGpu::Unknown {
+            return false;
+        }
+        self.resolve(gpus).is_ok()
+    }
+
+    /// Resolve the DRM cards and eDP connectors of both GPUs from their PCI addresses.
+    pub fn resolve(&self, gpus: &[MuxGpu]) -> Result<MuxTopology, MuxError> {
+        let find = |nvidia: bool| {
+            gpus.iter()
+                .filter(|gpu| gpu.nvidia == nvidia)
+                .find_map(|gpu| {
+                    let card = drm_card_for_pci(&gpu.pci)?;
+                    let edp = edp_connector(&gpu.pci, &card)?;
+                    Some((gpu.pci.clone(), card, edp))
+                })
+        };
+        let (dgpu_pci, dgpu_card, dgpu_edp) = find(true).ok_or_else(|| {
+            MuxError::NotCapable("no available NVIDIA GPU with an eDP connector".to_string())
+        })?;
+        let (igpu_pci, igpu_card, igpu_edp) = find(false).ok_or_else(|| {
+            MuxError::NotCapable("no available integrated GPU with an eDP connector".to_string())
+        })?;
+        Ok(MuxTopology {
+            igpu_pci,
+            dgpu_pci,
+            igpu_card,
+            dgpu_card,
+            igpu_edp,
+            dgpu_edp,
+        })
+    }
+
+    /// Whether the dGPU eDP connector reports `connected`.
+    pub async fn dgpu_panel_connected(&self, topo: &MuxTopology) -> bool {
+        read_attr(&topo.dgpu_edp.join("status"))
+            .await
+            .is_ok_and(|status| status == "connected")
+    }
+
+    /// Move the internal panel to the dGPU.
+    ///
+    /// Any failure after the mux write, or missing the overall deadline before the compositor lit
+    /// the dGPU panel, reverts the panel to the iGPU.
+    pub async fn enter_dgpu(&self, topo: &MuxTopology) -> Result<(), MuxError> {
+        if self.is_wedged() {
+            return Err(MuxError::Wedged);
+        }
+        info!(
+            "mux: entering dGPU (iGPU {} {} -> dGPU {} {})",
+            topo.igpu_pci,
+            topo.igpu_edp.display(),
+            topo.dgpu_pci,
+            topo.dgpu_edp.display()
+        );
+        let started = Instant::now();
+
+        // (1) Keep the dGPU awake for the whole sequence
+        let power = power_control(&topo.dgpu_pci);
+        info!(
+            "mux: [1/7] forcing dGPU runtime PM on ({})",
+            power.display()
+        );
+        write_attr(&power, "on").await?;
+
+        // (2) Hand over the current iGPU backlight level
+        match igpu_brightness_percent().await {
+            Some(percent) => {
+                info!("mux: [2/7] handing over brightness {percent}%");
+                if let Err(err) =
+                    write_attr(Path::new(MUX_BRIGHTNESS_PARAM), &percent.to_string()).await
+                {
+                    warn!("mux: could not hand over the brightness: {err}");
+                }
+            }
+            None => warn!("mux: [2/7] no amdgpu backlight found, skipping brightness handover"),
+        }
+
+        // (3..6) under a deadline, (3) included as the mux write itself can hang
+        info!("mux: [3/7] switching mux to dgpu");
+        let result = match tokio::time::timeout(ENTER_DEADLINE, self.enter_dgpu_inner(topo)).await {
+            Ok(result) => result,
+            Err(_) => Err(MuxError::Timeout {
+                what: "dGPU panel was not lit before the safety deadline".to_string(),
+                timeout: ENTER_DEADLINE,
+            }),
+        };
+
+        if let Err(cause) = result {
+            error!("mux: entering dGPU failed: {cause}; reverting to the iGPU");
+            return match self.leave_to_igpu(topo, true).await {
+                Ok(()) => Err(MuxError::Reverted {
+                    cause: Box::new(cause),
+                }),
+                Err(revert) => {
+                    error!("mux: revert to the iGPU failed: {revert}");
+                    Err(MuxError::RevertFailed {
+                        cause: Box::new(cause),
+                        revert: Box::new(revert),
+                    })
+                }
+            };
+        }
+
+        // (7) The dGPU panel is lit: turn the iGPU connector off and tell the compositor.
+        // Best effort, the panel is already usable.
+        info!(
+            "mux: [7/7] turning {} off and notifying {}",
+            topo.igpu_edp.display(),
+            topo.igpu_card
+        );
+        if let Err(err) = write_attr(&topo.igpu_edp.join("status"), "off").await {
+            warn!("mux: could not turn the iGPU eDP connector off: {err}");
+        }
+        if let Err(err) = synthetic_hotplug(&topo.igpu_card).await {
+            warn!("mux: hotplug on {} failed: {err}", topo.igpu_card);
+        }
+        info!(
+            "mux: panel is on the dGPU (took {} ms)",
+            started.elapsed().as_millis()
+        );
+        Ok(())
+    }
+
+    /// Steps 3 to 6 of the enter sequence.
+    async fn enter_dgpu_inner(&self, topo: &MuxTopology) -> Result<(), MuxError> {
+        // (3) Flip the mux
+        self.write_mux("dgpu").await?;
+
+        // (4) Force detection until the dGPU connector sees the panel
+        info!(
+            "mux: [4/7] waiting for {} to be connected",
+            topo.dgpu_edp.display()
+        );
+        poll_detect(&topo.dgpu_edp, DETECT_TIMEOUT).await?;
+
+        // (5) Tell the compositor the dGPU has a new panel
+        info!("mux: [5/7] synthetic hotplug on {}", topo.dgpu_card);
+        synthetic_hotplug(&topo.dgpu_card).await?;
+
+        // (6) Wait for the compositor to light it
+        info!(
+            "mux: [6/7] waiting for the compositor to enable {}",
+            topo.dgpu_edp.display()
+        );
+        let enabled = topo.dgpu_edp.join("enabled");
+        let deadline = Instant::now() + ENABLE_TIMEOUT;
+        loop {
+            if read_attr(&enabled).await.is_ok_and(|v| v == "enabled") {
+                return Ok(());
+            }
+            if Instant::now() >= deadline {
+                return Err(MuxError::Timeout {
+                    what: format!("{} was not enabled by the compositor", enabled.display()),
+                    timeout: ENABLE_TIMEOUT,
+                });
+            }
+            tokio::time::sleep(POLL_INTERVAL).await;
+        }
+    }
+
+    /// Move the internal panel back to the iGPU.
+    /// With `wait_lit` false (shutdown: the compositor may be gone and logind only waits a few
+    /// seconds) the dGPU connector is dropped without waiting for the iGPU panel to be lit.
+    pub async fn leave_to_igpu(&self, topo: &MuxTopology, wait_lit: bool) -> Result<(), MuxError> {
+        info!(
+            "mux: leaving to iGPU (dGPU {} -> iGPU {})",
+            topo.dgpu_edp.display(),
+            topo.igpu_edp.display()
+        );
+
+        // (1) Flip the mux, through the driver unless it is known to be wedged
+        info!("mux: [1/5] switching mux to igpu");
+        let driver_result = if self.is_wedged() {
+            Err(MuxError::Wedged)
+        } else {
+            self.write_mux("igpu").await
+        };
+        if let Err(err) = driver_result {
+            warn!("mux: driver path failed ({err}), falling back to ACPI");
+            self.wedged.store(true, Ordering::Relaxed);
+            acpi_mux_to_igpu().await?;
+        }
+
+        // (2) Wait for the iGPU connector to see the panel, then tell the compositor
+        info!(
+            "mux: [2/5] waiting for {} to be connected",
+            topo.igpu_edp.display()
+        );
+        let detected = poll_detect(&topo.igpu_edp, DETECT_TIMEOUT).await;
+        if let Err(err) = synthetic_hotplug(&topo.igpu_card).await {
+            warn!("mux: hotplug on {} failed: {err}", topo.igpu_card);
+        }
+        // Without the iGPU seeing the panel, turning the dGPU connector off could leave the
+        // user with a black screen: stop here.
+        detected?;
+
+        // (3) Wait until the iGPU panel is actually lit (compositor or fbcon) before dropping
+        // the dGPU connector. A compositor that still renders on the dGPU may only manage
+        // that once the dGPU connector is gone (that's what moves its renderer), so if it
+        // isn't lit in time, drop the dGPU connector anyway and wait once more.
+        let igpu_enabled = topo.igpu_edp.join("enabled");
+        info!(
+            "mux: [3/5] waiting for {} to be lit",
+            topo.igpu_edp.display()
+        );
+        let mut lit = !wait_lit;
+        if wait_lit {
+            tokio::time::sleep(LEAVE_SETTLE).await;
+            lit = wait_enabled(&igpu_enabled, ENABLE_TIMEOUT).await;
+        }
+        if !lit {
+            warn!(
+                "mux: {} not lit yet, dropping the dGPU connector anyway",
+                topo.igpu_edp.display()
+            );
+        }
+
+        // (4) Drop the dGPU connector
+        info!(
+            "mux: [4/5] turning {} off and notifying {}",
+            topo.dgpu_edp.display(),
+            topo.dgpu_card
+        );
+        if let Err(err) = write_attr(&topo.dgpu_edp.join("status"), "off").await {
+            warn!("mux: could not turn the dGPU eDP connector off: {err}");
+        }
+        if let Err(err) = synthetic_hotplug(&topo.dgpu_card).await {
+            warn!("mux: hotplug on {} failed: {err}", topo.dgpu_card);
+        }
+        if !lit {
+            lit = wait_enabled(&igpu_enabled, ENABLE_TIMEOUT).await;
+        }
+
+        // (5) Let the dGPU runtime suspend again
+        let power = power_control(&topo.dgpu_pci);
+        info!("mux: [5/5] restoring dGPU runtime PM ({})", power.display());
+        if let Err(err) = write_attr(&power, "auto").await {
+            warn!("mux: could not restore dGPU runtime PM: {err}");
+        }
+
+        if !lit {
+            // The panel is on the iGPU, but nothing displays on it. Report it so that modes
+            // which block the dGPU are refused (the compositor may still render there).
+            return Err(MuxError::Timeout {
+                what: format!(
+                    "{} was not lit by the compositor after the switch",
+                    igpu_enabled.display()
+                ),
+                timeout: ENABLE_TIMEOUT,
+            });
+        }
+        info!("mux: panel is on the iGPU");
+        Ok(())
+    }
+
+    /// Write the mux parameter on a dedicated thread. A timeout (writer stuck in the driver)
+    /// marks the driver path as wedged; [`Self::leave_to_igpu`] also marks it on plain errors.
+    async fn write_mux(&self, target: &'static str) -> Result<(), MuxError> {
+        let result = sysfs_io(
+            format!("write {target} to {MUX_PARAM}"),
+            MUX_WRITE_TIMEOUT,
+            move || fs::write(MUX_PARAM, target),
+        )
+        .await;
+        match &result {
+            Err(err @ MuxError::Timeout { .. }) => {
+                error!("mux: writing {target} to the mux hung: {err}; marking driver path wedged");
+                self.wedged.store(true, Ordering::Relaxed);
+            }
+            Err(err) => error!("mux: writing {target} to the mux failed: {err}"),
+            Ok(()) => {}
+        }
+        result
+    }
+}
+
+/// Last resort: flip the mux back to the iGPU through acpi_call.
+async fn acpi_mux_to_igpu() -> Result<(), MuxError> {
+    if !Path::new(ACPI_CALL).exists() {
+        return Err(MuxError::Step(format!(
+            "{ACPI_CALL} is not available, cannot fall back to ACPI"
+        )));
+    }
+    info!("mux: calling {ACPI_MXDS_IGPU} through {ACPI_CALL}");
+    write_attr(Path::new(ACPI_CALL), ACPI_MXDS_IGPU).await?;
+    match read_attr(Path::new(ACPI_CALL)).await {
+        Ok(answer) if answer.starts_with("Error") => Err(MuxError::Step(format!(
+            "ACPI call {ACPI_MXDS_IGPU} failed: {answer}"
+        ))),
+        Ok(answer) => {
+            info!("mux: ACPI call answered: {answer}");
+            Ok(())
+        }
+        Err(err) => {
+            warn!("mux: could not read the ACPI call answer: {err}");
+            Ok(())
+        }
+    }
+}
+
+/// Force detection on a connector until it reports `connected`.
+async fn poll_detect(connector: &Path, timeout: Duration) -> Result<(), MuxError> {
+    let status = connector.join("status");
+    let deadline = Instant::now() + timeout;
+    loop {
+        if let Err(err) = write_attr(&status, "detect").await {
+            warn!("mux: detect on {} failed: {err}", status.display());
+        }
+        if read_attr(&status).await.is_ok_and(|s| s == "connected") {
+            return Ok(());
+        }
+        if Instant::now() >= deadline {
+            return Err(MuxError::Timeout {
+                what: format!("{} never reported connected", connector.display()),
+                timeout,
+            });
+        }
+        tokio::time::sleep(POLL_INTERVAL).await;
+    }
+}
+
+/// Send a synthetic `change` uevent on a DRM card, tagged so a udev rule turns it into
+/// `HOTPLUG=1` for the compositor.
+async fn synthetic_hotplug(card: &str) -> Result<(), MuxError> {
+    let uuid = read_attr(Path::new("/proc/sys/kernel/random/uuid")).await?;
+    // The kernel only accepts alphanumeric keys: SYNTH_ARG_MUXHOTPLUG=1 is mapped to HOTPLUG=1
+    // by udev
+    let payload = format!("change {uuid} MUXHOTPLUG=1");
+    let uevent = Path::new("/sys/class/drm").join(card).join("uevent");
+    write_attr(&uevent, &payload).await
+}
+
+/// Whether a compositor holds the dGPU's DRM card: some process that has both GPUs' card nodes
+/// open, other than session plumbing. Without it nothing can light the panel on the dGPU (the
+/// nvidia fbdev console would still make the connector read "enabled").
+///
+/// A compositor that started while the dGPU was blocked (Integrated/Smart at login) never gets
+/// it: NVIDIA's EGL does not re-scan devices inside a running process, so offering it the card
+/// later doesn't help (wlroots falls back to its experimental Vulkan renderer and hangs).
+pub async fn compositor_holds_dgpu(topo: &MuxTopology) -> bool {
+    const NOT_A_COMPOSITOR: [&str; 5] = [
+        "systemd",
+        "systemd-logind",
+        "Xwayland",
+        ".cardwired-wrap",
+        "cardwired",
+    ];
+    let igpu = format!("/dev/dri/{}", topo.igpu_card);
+    let dgpu = format!("/dev/dri/{}", topo.dgpu_card);
+    let result = tokio::task::spawn_blocking(move || -> io::Result<bool> {
+        let on_igpu = crate::core::procfs::lsof_read(&igpu)?;
+        let on_dgpu = crate::core::procfs::lsof_read(&dgpu)?;
+        Ok(on_dgpu
+            .iter()
+            .any(|p| !NOT_A_COMPOSITOR.contains(&p.as_str()) && on_igpu.contains(p)))
+    })
+    .await;
+    matches!(result, Ok(Ok(true)))
+}
+
+/// Current amdgpu backlight level in percent.
+async fn igpu_brightness_percent() -> Option<u32> {
+    let mut entries = tokio::fs::read_dir("/sys/class/backlight").await.ok()?;
+    while let Ok(Some(entry)) = entries.next_entry().await {
+        if !entry.file_name().to_string_lossy().starts_with("amdgpu_bl") {
+            continue;
+        }
+        let path = entry.path();
+        let brightness: u64 = read_attr(&path.join("brightness"))
+            .await
+            .ok()?
+            .parse()
+            .ok()?;
+        let max: u64 = read_attr(&path.join("max_brightness"))
+            .await
+            .ok()?
+            .parse()
+            .ok()?;
+        return brightness_percent(brightness, max);
+    }
+    None
+}
+
+fn brightness_percent(brightness: u64, max: u64) -> Option<u32> {
+    if max == 0 {
+        return None;
+    }
+    let percent = brightness.saturating_mul(100) / max;
+    Some(percent.min(100) as u32)
+}
+
+fn power_control(pci: &str) -> PathBuf {
+    Path::new("/sys/bus/pci/devices")
+        .join(pci)
+        .join("power/control")
+}
+
+/// Find the DRM card (e.g. `card1`) owned by a PCI device.
+fn drm_card_for_pci(pci: &str) -> Option<String> {
+    let drm_dir = Path::new("/sys/bus/pci/devices").join(pci).join("drm");
+    fs::read_dir(drm_dir).ok()?.flatten().find_map(|entry| {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        let is_card = name
+            .strip_prefix("card")
+            .is_some_and(|num| !num.is_empty() && num.chars().all(|c| c.is_ascii_digit()));
+        is_card.then_some(name)
+    })
+}
+
+/// Find the eDP connector of a card, returned as its `/sys/class/drm` path.
+fn edp_connector(pci: &str, card: &str) -> Option<PathBuf> {
+    let card_dir = Path::new("/sys/bus/pci/devices")
+        .join(pci)
+        .join("drm")
+        .join(card);
+    let prefix = format!("{card}-eDP-");
+    let mut connectors: Vec<String> = fs::read_dir(card_dir)
+        .ok()?
+        .flatten()
+        .map(|entry| entry.file_name().to_string_lossy().into_owned())
+        .filter(|name| name.starts_with(&prefix))
+        .collect();
+    connectors.sort();
+    connectors
+        .into_iter()
+        .next()
+        .map(|name| Path::new("/sys/class/drm").join(name))
+}
+
+/// Synchronous mux read used by the default GPU heuristic, bounded by a timeout.
+pub fn panel_on_dgpu_blocking() -> bool {
+    if !Path::new(MUX_PARAM).exists() {
+        return false;
+    }
+    let (tx, rx) = std::sync::mpsc::channel();
+    let spawned = std::thread::Builder::new()
+        .name("cardwire-mux-read".to_string())
+        .spawn(move || {
+            let _ = tx.send(fs::read_to_string(MUX_PARAM));
+        });
+    if spawned.is_err() {
+        return false;
+    }
+    matches!(rx.recv_timeout(SYSFS_TIMEOUT), Ok(Ok(value)) if PanelGpu::parse(&value) == PanelGpu::Dgpu)
+}
+
+async fn read_attr(path: &Path) -> Result<String, MuxError> {
+    let owned = path.to_path_buf();
+    sysfs_io(
+        format!("read {}", path.display()),
+        SYSFS_TIMEOUT,
+        move || fs::read_to_string(owned).map(|value| value.trim().to_string()),
+    )
+    .await
+}
+
+async fn write_attr(path: &Path, value: &str) -> Result<(), MuxError> {
+    let owned = path.to_path_buf();
+    let value = value.to_string();
+    sysfs_io(
+        format!("write {}", path.display()),
+        SYSFS_TIMEOUT,
+        move || fs::write(owned, value),
+    )
+    .await
+}
+
+/// Run a sysfs access on a dedicated detached thread, bounded by a timeout.
+///
+/// On timeout the thread is abandoned: if it is stuck in uninterruptible sleep it leaks, but
+/// neither the runtime nor its shutdown wait on it.
+async fn sysfs_io<T, F>(what: String, timeout: Duration, op: F) -> Result<T, MuxError>
+where
+    T: Send + 'static,
+    F: FnOnce() -> io::Result<T> + Send + 'static,
+{
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    std::thread::Builder::new()
+        .name("cardwire-mux-io".to_string())
+        .spawn(move || {
+            let _ = tx.send(op());
+        })
+        .map_err(|source| MuxError::Io {
+            path: what.clone(),
+            source,
+        })?;
+    match tokio::time::timeout(timeout, rx).await {
+        Ok(Ok(Ok(value))) => Ok(value),
+        Ok(Ok(Err(source))) => Err(MuxError::Io { path: what, source }),
+        Ok(Err(_)) => Err(MuxError::Step(format!("{what}: worker thread vanished"))),
+        Err(_) => Err(MuxError::Timeout { what, timeout }),
+    }
+}
+
+/// Poll a DRM connector's `enabled` attribute until it reads "enabled" or the timeout expires.
+async fn wait_enabled(path: &Path, timeout: Duration) -> bool {
+    let deadline = Instant::now() + timeout;
+    loop {
+        if read_attr(path).await.is_ok_and(|v| v == "enabled") {
+            return true;
+        }
+        if Instant::now() >= deadline {
+            return false;
+        }
+        tokio::time::sleep(POLL_INTERVAL).await;
+    }
+}
