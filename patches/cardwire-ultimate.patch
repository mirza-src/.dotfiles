+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_panel_gpu_parse() {
+        assert_eq!(PanelGpu::parse("igpu\n"), PanelGpu::Igpu);
+        assert_eq!(PanelGpu::parse("dgpu"), PanelGpu::Dgpu);
+        assert_eq!(PanelGpu::parse("unknown"), PanelGpu::Unknown);
+        assert_eq!(PanelGpu::parse(""), PanelGpu::Unknown);
+    }
+
+    #[test]
+    fn test_brightness_percent() {
+        assert_eq!(brightness_percent(0, 255), Some(0));
+        assert_eq!(brightness_percent(255, 255), Some(100));
+        assert_eq!(brightness_percent(128, 255), Some(50));
+        assert_eq!(brightness_percent(300, 255), Some(100));
+        assert_eq!(brightness_percent(10, 0), None);
+    }
+
+    #[test]
+    fn test_state_priority() {
+        let mux = MuxController::new();
+        assert_eq!(mux.state(), MuxState::Idle);
+        mux.set_pending(true);
+        assert_eq!(mux.state(), MuxState::Pending);
+        mux.set_degraded("boom");
+        assert_eq!(mux.state(), MuxState::Degraded);
+        assert_eq!(mux.last_error(), "boom");
+        mux.set_switching(true);
+        assert_eq!(mux.state(), MuxState::Switching);
+        mux.set_switching(false);
+        mux.clear_degraded();
+        assert_eq!(mux.state(), MuxState::Pending);
+    }
+
+    #[tokio::test]
+    async fn test_sysfs_io_timeout() {
+        let res = sysfs_io("sleep".to_string(), Duration::from_millis(50), || {
+            std::thread::sleep(Duration::from_millis(500));
+            Ok(())
+        })
+        .await;
+        assert!(matches!(res, Err(MuxError::Timeout { .. })));
+    }
+
+    #[tokio::test]
+    async fn test_sysfs_io_error() {
+        let res: Result<String, _> = sysfs_io("missing".to_string(), SYSFS_TIMEOUT, || {
+            fs::read_to_string("/nonexistent/cardwire/mux")
+        })
+        .await;
+        assert!(matches!(res, Err(MuxError::Io { .. })));
+    }
+}
