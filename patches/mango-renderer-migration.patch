+/*
+ * setrendergpu,<card0|renderD128|/dev/dri/...|recreate>
+ * Make the given DRM device the primary (rendering) GPU. wlroots then emits
+ * renderer->events.lost and do_renderer_recreate() migrates everything.
+ * "recreate" just recreates the renderer on the current primary GPU.
+ */
+int32_t set_render_gpu(const Arg *arg) {
+	const char *want = arg ? arg->v : NULL;
+
+	if (!want || want[0] == '\0') {
+		mango_error(true, WLR_ERROR,
+					"setrendergpu: missing DRM device argument");
+		return 0;
+	}
+
+	if (strcmp(want, "recreate") == 0) {
+		handle_renderer_lost(NULL, NULL);
+		return 0;
+	}
+
+#ifdef WLR_DRM_HAS_DYNAMIC_PRIMARY
+	struct render_gpu_match ctx = {0};
+	char resolved[PATH_MAX];
+
+	if (strchr(want, '/'))
+		snprintf(ctx.path, sizeof(ctx.path), "%s",
+				 realpath(want, resolved) ? resolved : want);
+	else
+		snprintf(ctx.path, sizeof(ctx.path), "%s", want);
+
+	if (!wlr_backend_is_multi(server.backend)) {
+		if (wlr_backend_is_drm(server.backend))
+			find_render_gpu_backend(server.backend, &ctx);
+	} else {
+		wlr_multi_for_each_backend(server.backend, find_render_gpu_backend,
+								   &ctx);
+	}
+
+	if (!ctx.match) {
+		mango_error(true, WLR_ERROR,
+					"setrendergpu: no DRM backend matches '%s' (%d DRM "
+					"backends)",
+					want, ctx.candidates);
+		return 0;
+	}
+
+	if (wlr_drm_backend_get_primary(ctx.match) == ctx.match) {
+		mango_error(true, WLR_INFO, "setrendergpu: '%s' is already primary",
+					want);
+		return 0;
+	}
+
+	if (!wlr_drm_backend_set_primary(ctx.match))
+		mango_error(true, WLR_ERROR,
+					"setrendergpu: wlroots refused to make '%s' primary", want);
+	else
+		mango_error(true, WLR_INFO, "setrendergpu: '%s' is now primary", want);
+#else
+	mango_error(true, WLR_ERROR,
+				"setrendergpu: '%s' ignored, wlroots lacks dynamic primary GPU "
+				"support (WLR_DRM_HAS_DYNAMIC_PRIMARY)",
+				want);
+#endif
+	return 0;
+}
