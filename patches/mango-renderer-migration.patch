+		if (c->iskilling || client_is_x11(c) || !client_surface(c) ||
+			!client_surface(c)->mapped || !c->surface.xdg ||
+			!c->surface.xdg->initialized)
+			continue;
+		wlr_xdg_surface_schedule_configure(c->surface.xdg);
+	}
