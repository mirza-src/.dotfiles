+#ifdef WLR_DRM_HAS_DYNAMIC_PRIMARY
+struct render_gpu_match {
+	char path[PATH_MAX];
+	struct wlr_backend *match;
+	int32_t candidates;
+};
+
+static bool drm_device_has_node(drmDevicePtr dev, const char *path) {
+	for (int32_t i = 0; i < DRM_NODE_MAX; i++) {
+		if (!(dev->available_nodes & (1 << i)) || !dev->nodes[i])
+			continue;
+		if (strcmp(dev->nodes[i], path) == 0)
+			return true;
+		const char *base = strrchr(dev->nodes[i], '/');
+		if (base && strcmp(base + 1, path) == 0)
+			return true;
+	}
+	return false;
+}
+
+static void find_render_gpu_backend(struct wlr_backend *backend, void *data) {
+	struct render_gpu_match *ctx = data;
+	drmDevicePtr dev = NULL;
+
+	if (!wlr_backend_is_drm(backend))
+		return;
+	ctx->candidates++;
+
+	int32_t fd = wlr_backend_get_drm_fd(backend);
+	if (fd < 0 || drmGetDevice2(fd, 0, &dev) != 0 || !dev)
+		return;
+	if (!ctx->match && drm_device_has_node(dev, ctx->path))
+		ctx->match = backend;
+	drmFreeDevice(&dev);
+}
+#endif
